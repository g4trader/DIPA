# Configuração para ambiente de PRODUÇÃO
# Este arquivo é um template - NÃO comitar valores reais
# Configure estas variáveis no painel da Vercel para o projeto dipam-smartiasolutions

# Ambiente: produção (usa backend real)
NEXT_PUBLIC_DIPAM_ENV=prod

# URL base do backend Cloud Run (produção)
NEXT_PUBLIC_DIPAM_API_URL=https://dipam-ai-backend-642830139828.us-central1.run.app

# Identificador do ambiente do projeto
NEXT_PUBLIC_PROJECT_ENV=production

# URL alternativa (compatibilidade com código legado)
NEXT_PUBLIC_BACKEND_URL=https://dipam-ai-backend-642830139828.us-central1.run.app
NEXT_PUBLIC_API_BASE_URL=https://dipam-ai-backend-642830139828.us-central1.run.app
