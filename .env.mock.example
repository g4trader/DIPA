# Configuração para ambiente de MOCK / LABORATÓRIO
# Este arquivo é um template - NÃO comitar valores reais
# Configure estas variáveis no painel da Vercel para o projeto dipam-vercel

# Ambiente: mock (usa snapshots locais, sem backend)
NEXT_PUBLIC_DIPAM_ENV=mock

# URL base do backend (não usado em mock, mas mantido para compatibilidade)
NEXT_PUBLIC_DIPAM_API_URL=http://localhost:3000/api/mock

# Identificador do ambiente do projeto
NEXT_PUBLIC_PROJECT_ENV=mock

# URLs alternativas (compatibilidade com código legado)
# Em modo mock, essas URLs não são usadas - o código usa /api/mock/ask diretamente
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000/api/mock
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/mock
