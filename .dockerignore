# Docker ignore file
# Arquivos e diretórios que não devem ser incluídos na imagem Docker

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
env/
ENV/
.venv

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Environment variables
.env
.env.local
.env.*.local

# Logs
*.log
logs/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# Data files
data/raw/
data/processed/
# Permite copiar o banco SQLite populado pelo ETL para produção
!data/dipam_dw.db
*.db
*.sqlite

# ML models (se não quiser incluir na imagem)
ml/models/
ml/checkpoints/

# Git
.git/
.gitignore

# Documentation
*.md
!README.md

# OS
.DS_Store
Thumbs.db

# Node modules (se houver)
node_modules/



